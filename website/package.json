{
  "name": "fieldfox-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4188 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4188 --strictPort",
    "enquiry:server": "node server/index.mjs",
    "test:enquiry": "node --test tests/enquiry-server.test.mjs",
    "test:browser": "FIELDFOX_BROWSER_TESTS=1 node --test tests/*browser.test.mjs",
    "assets": "node scripts/assets.mjs",
    "format": "prettier --write src server tests scripts *.ts *.html"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.1.4",
    "prettier": "3.8.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}