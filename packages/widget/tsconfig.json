{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    // Vite owns the JS bundles; tsc emits only the declaration files (types entry).
    "emitDeclarationOnly": true,
    "types": [],
    // The widget is DOM-native (custom element, shadow DOM, observers); pull in
    // the browser lib on top of the base ES2022 lib.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
