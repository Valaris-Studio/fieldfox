{
  "name": "@fieldfox/server",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valaris-Studio/fieldfox.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dev": "tsc -b && node dist/serve.js",
    "start": "node dist/serve.js"
  },
  "dependencies": {
    "@fieldfox/shared": "workspace:*",
    "@hono/node-server": "^1",
    "hono": "^4",
    "zod": "^4"
  },
  "peerDependencies": {
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
